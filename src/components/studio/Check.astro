---
/**
 * A single understanding check. The explanation is in the page, inside a disclosure,
 * so it remains available without JavaScript. The script only adds a verdict.
 */
interface Props {
  id: string;
  prompt: string;
  choices: readonly string[];
  /** The choice text that should be selected. It must be one of `choices`. */
  answer: string;
  why: string;
}

const { id, prompt, choices, answer, why } = Astro.props;
if (!choices.includes(answer)) {
  throw new Error(`Check “${id}” has an answer that is not one of its choices.`);
}
---

<form data-check data-answer={answer} class="not-prose mt-6 border border-line p-4">
  <fieldset>
    <legend class="text-sm leading-relaxed text-ink">{prompt}</legend>
    <div class="mt-3 space-y-2">
      {
        choices.map((choice) => (
          <label class="flex items-start gap-3 text-sm leading-relaxed text-ink-muted">
            <input
              type="radio"
              name={`check-${id}`}
              value={choice}
              class="mt-1"
              required
            />
            <span>{choice}</span>
          </label>
        ))
      }
    </div>
    <button type="submit" class="mono-label mt-4 rounded-sm bg-ink px-3 py-2 text-canvas">
      Check answer
    </button>
    <p data-verdict class="mt-3 hidden text-sm text-ink" role="status"></p>
    <details class="mt-3">
      <summary class="cursor-pointer text-sm text-ink-muted">Explanation</summary>
      <p class="mt-2 text-sm leading-relaxed text-ink-muted">{why}</p>
    </details>
  </fieldset>
</form>
