---
/**
 * The studio bench. The figure is the instrument. The lesson is a column you can
 * open beside it, not a second page under a row of every other experiment.
 */
import 'katex/dist/katex.min.css';
import GradientDescentStudio from '@/components/studio/GradientDescentStudio';
import LessonReading from '@/components/studio/LessonReading.astro';
import Viz from '@/components/visualizations/Viz.astro';
import type { LiveVisualizationId } from '@/components/visualizations/registry';
import { getStudioDomain, liveStudioModules, resolveStep, type StudioModule } from '@/data/studio';
import type { StudioLesson } from '@/lib/content';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  module: StudioModule;
  lesson: StudioLesson;
}

const { module, lesson } = Astro.props;
const domain = getStudioDomain(lesson.data.domain);
const bench = module.id === 'gradient-descent';
const siblings = liveStudioModules().filter(
  (item) => item.domainId === lesson.data.domain && item.id !== module.id,
);

function isEmbeddedViz(id: string): id is Exclude<LiveVisualizationId, 'gradient-descent'> {
  return (
    id === 'sample-mean' ||
    id === 'dot-product' ||
    id === 'loss-functions' ||
    id === 'neuron' ||
    id === 'activations' ||
    id === 'backpropagation' ||
    id === 'attention-patterns' ||
    id === 'tokenization' ||
    id === 'next-token' ||
    id === 'entropy' ||
    id === 'normalization' ||
    id === 'confusion' ||
    id === 'neighbors' ||
    id === 'convolution' ||
    id === 'positional-encoding' ||
    id === 'decision-boundaries' ||
    id === 'transformer-block' ||
    id === 'embedding-space' ||
    id === 'agent-loop'
  );
}

const relations = [
  { label: 'Prerequisite', id: lesson.data.prerequisites[0] },
  { label: 'Related', id: lesson.data.related[0] },
  { label: 'Continue', id: lesson.data.next },
]
  .filter((item): item is { label: string; id: string } => typeof item.id === 'string')
  .map((item) => ({ ...item, step: resolveStep(item.id) }));
---

<BaseLayout title={`${lesson.data.title} — Learning Studio`} description={lesson.data.description}>
  {
    bench ? (
      <article class="studio-bench" data-studio-module data-module={module.id}>
        <input id="lesson-open" type="checkbox" class="sr-only" />
        <header class="flex items-center gap-4 border-b border-line px-gutter py-3">
          <div class="min-w-0 flex-1">
            <p class="mono-label truncate text-ink-faint">
              <a href="/studio" class="hover:text-ink">
                Studio
              </a>
              {domain && (
                <>
                  <span class="mx-2" aria-hidden="true">
                    /
                  </span>
                  <a href={`/studio/domain/${domain.id}`} class="hover:text-ink">
                    {domain.title}
                  </a>
                </>
              )}
            </p>
            <h1 class="truncate font-serif text-[1.375rem] leading-tight tracking-tight text-ink">
              {lesson.data.title}
            </h1>
          </div>
          <label
            for="lesson-open"
            class="inline-flex h-9 shrink-0 cursor-pointer items-center gap-2 rounded-sm border border-accent/50 px-3 text-sm text-accent hover:bg-accent/10"
          >
            <span class="lesson-open-label">Lesson</span>
            <span class="lesson-close-label">Close lesson</span>
            <kbd class="font-mono text-[0.65rem] text-ink-faint">L</kbd>
          </label>
        </header>

        <div class="studio-bench-body">
          <div class="studio-stage">
            <GradientDescentStudio client:visible />
          </div>
          <aside id="lesson-panel" class="lesson-panel border-line" aria-label="Lesson">
            <LessonReading
              panel
              title={lesson.data.title}
              summary={lesson.data.summary}
              experiments={lesson.data.experiments}
              relations={relations}
              siblings={siblings}
              domainTitle={domain?.title}
            >
              <slot />
            </LessonReading>
          </aside>
        </div>
      </article>
    ) : (
      <article class="mx-auto min-w-0 max-w-page" data-studio-module data-module={module.id}>
        <header class="px-gutter pt-8 pb-6">
          <p class="mono-label text-ink-faint">
            <a href="/studio" class="hover:text-ink">
              Studio
            </a>
            {domain && (
              <>
                <span class="mx-2" aria-hidden="true">
                  /
                </span>
                <a href={`/studio/domain/${domain.id}`} class="hover:text-ink">
                  {domain.title}
                </a>
              </>
            )}
            <span class="mx-2" aria-hidden="true">
              /
            </span>
            {lesson.data.difficulty}
          </p>
          <h1 class="mt-3 max-w-3xl font-serif text-[clamp(2rem,1.5rem+1.4vw,2.75rem)] leading-none tracking-tight text-ink">
            {lesson.data.title}
          </h1>
          <p class="mt-4 max-w-2xl text-lede text-ink-muted">{lesson.data.summary}</p>
        </header>

        <div class="border-y border-line">
          {isEmbeddedViz(module.id) && (
            <div class="px-gutter py-8">
              <Viz id={module.id} />
            </div>
          )}
        </div>

        <div class="mx-auto grid max-w-page gap-x-10 px-gutter py-10 lg:grid-cols-12">
          <aside class="lg:col-span-3">
            <div class="lg:sticky lg:top-24">
              <p class="mono-label text-ink-faint">Parts</p>
              <ol data-toc class="mt-3"></ol>
              <p class="mono-label mt-4 text-ink-faint" data-progress aria-live="polite">
                Nothing marked yet
              </p>
              <div class="mt-2 h-px w-full bg-line" aria-hidden="true">
                <div data-progress-bar class="h-px bg-accent" style="width: 0%"></div>
              </div>
            </div>
          </aside>
          <div class="mt-8 min-w-0 lg:col-span-9 lg:mt-0">
            <LessonReading experiments={lesson.data.experiments} relations={relations} siblings={siblings} domainTitle={domain?.title}>
              <slot />
            </LessonReading>
          </div>
        </div>
      </article>
    )
  }
</BaseLayout>

<script>
  import { mountStudioModule } from '@/lib/studio-client';

  const root = document.querySelector('[data-studio-module]');
  if (root instanceof HTMLElement) mountStudioModule(root);

  const lessonToggle = document.querySelector<HTMLInputElement>('#lesson-open');
  if (lessonToggle) {
    const typing = (target: EventTarget | null) => {
      if (!(target instanceof HTMLElement)) return false;
      const tag = target.tagName;
      return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || target.isContentEditable;
    };
    document.addEventListener('keydown', (event) => {
      if (typing(event.target)) return;
      if (event.key === 'l' || event.key === 'L') {
        event.preventDefault();
        lessonToggle.checked = !lessonToggle.checked;
      } else if (event.key === 'Escape' && lessonToggle.checked) {
        lessonToggle.checked = false;
      }
    });
  }
</script>

<style>
  .lesson-close-label {
    display: none;
  }

  .studio-bench:has(#lesson-open:checked) .lesson-open-label {
    display: none;
  }

  .studio-bench:has(#lesson-open:checked) .lesson-close-label {
    display: inline;
  }

  .studio-bench:has(#lesson-open:checked) label[for='lesson-open'] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .studio-bench:has(#lesson-open:checked) label[for='lesson-open'] kbd {
    color: var(--accent-ink);
  }

  @media (min-width: 64rem) {
    .studio-bench {
      display: flex;
      min-height: 0;
      flex: 1;
      flex-direction: column;
      overflow: hidden;
    }

    .studio-bench-body {
      display: flex;
      min-height: 0;
      flex: 1;
    }

    .studio-stage {
      display: flex;
      min-width: 0;
      min-height: 0;
      flex: 1;
      flex-direction: column;
    }

    .studio-stage :global(astro-island) {
      display: flex;
      min-height: 0;
      flex: 1;
      flex-direction: column;
    }

    :global(body:has(.studio-bench)) {
      height: 100dvh;
      overflow: hidden;
    }

    :global(body:has(.studio-bench) footer) {
      display: none;
    }

    :global(body:has(.studio-bench) #main) {
      display: flex;
      min-height: 0;
      flex-direction: column;
    }

    .lesson-panel {
      width: min(34rem, 42vw);
      overflow: auto;
      border-left-width: 1px;
    }
  }

  .lesson-panel {
    display: none;
  }

  .studio-bench:has(#lesson-open:checked) .lesson-panel {
    display: block;
  }

  .lesson-panel :global([data-chapter]) {
    scroll-margin-top: 3.5rem;
  }
</style>
