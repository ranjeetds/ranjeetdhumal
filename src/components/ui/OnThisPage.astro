---
/**
 * Section list for a long page, built from the markdown headings so it works
 * without JavaScript. The script only moves the current-section mark.
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const sections = Astro.props.headings.filter((heading) => heading.depth === 2);
---

{
  sections.length > 1 && (
    <nav aria-label="On this page" class="mt-8" data-toc>
      <p class="mono-label text-ink-faint">On this page</p>
      <ol class="mt-3 space-y-1 text-sm">
        {sections.map((heading, index) => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-toc-link
              aria-current={index === 0 ? 'location' : undefined}
              class="block border-l border-transparent py-1 pl-3 text-ink-muted hover:text-ink aria-[current=location]:border-accent aria-[current=location]:text-ink"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<script>
  const toc = document.querySelector('[data-toc]');
  if (toc) {
    const pairs = [...toc.querySelectorAll('a[data-toc-link]')]
      .map((link) => {
        const id = link.getAttribute('href')?.slice(1) ?? '';
        const heading = id ? document.getElementById(id) : null;
        return link instanceof HTMLAnchorElement && heading ? { link, heading } : null;
      })
      .filter((pair): pair is { link: HTMLAnchorElement; heading: HTMLElement } => pair !== null);

    const mark = (id: string) => {
      for (const pair of pairs) {
        if (pair.heading.id === id) pair.link.setAttribute('aria-current', 'location');
        else pair.link.removeAttribute('aria-current');
      }
    };

    if (pairs.length > 1 && 'IntersectionObserver' in window) {
      const seen = new Map<string, number>();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.target instanceof HTMLElement) {
              seen.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
            }
          }
          const current = pairs.find((pair) => (seen.get(pair.heading.id) ?? 0) > 0);
          if (current) mark(current.heading.id);
        },
        { rootMargin: '-6rem 0px -55% 0px', threshold: [0, 1] },
      );
      for (const pair of pairs) observer.observe(pair.heading);
    }
  }
</script>
