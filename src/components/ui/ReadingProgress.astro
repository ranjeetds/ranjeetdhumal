---
/**
 * A hairline under the header that fills as the page scrolls. CSS only.
 * Hidden when the reader asks for reduced motion, because a bar that snaps
 * to the end is worse than no bar.
 */
---

<div class="reading-progress" aria-hidden="true"></div>

<style>
  .reading-progress {
    pointer-events: none;
    position: fixed;
    z-index: 30;
    top: 4rem;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .reading-progress {
        animation: reading-grow linear both;
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes reading-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress {
      display: none;
    }
  }
</style>
