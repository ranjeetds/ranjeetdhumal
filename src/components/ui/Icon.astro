---
/**
 * Inline stroke icons on a 24px grid. Add a path here rather than pulling in an icon
 * library; icons are decorative and always hidden from assistive technology.
 */
const icons = {
  'arrow-right': 'M5 12h14M13 6l6 6-6 6',
  'arrow-up-right': 'M7 17 17 7M8 7h9v9',
  menu: 'M4 8h16M4 16h16',
  close: 'M6 6l12 12M18 6 6 18',
  sun: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4',
  moon: 'M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5a8 8 0 1 0 10.8 10.8Z',
  play: 'M8 5.5v13l10.5-6.5L8 5.5Z',
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={['size-4 shrink-0', className]}
>
  <path d={icons[name]}></path>
</svg>
