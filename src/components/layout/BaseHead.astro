---
/**
 * Everything in <head>: metadata, canonical URL, Open Graph, JSON-LD, font preloads and
 * the theme bootstrap. Pages never write head tags themselves — they pass props to a layout.
 */
import sansFont from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import serifFont from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import { normalizePath, site } from '@/config/site';
import { absoluteUrl, personSchema, serializeGraph, websiteSchema } from '@/lib/seo';

interface Props {
  /** Page title without the site name. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Path or absolute URL of the social sharing image. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Extra schema.org nodes for this page. */
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  type = 'website',
  noindex = false,
  structuredData = [],
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = absoluteUrl(normalizePath(Astro.url.pathname));
const imageUrl = absoluteUrl(image);
const graph = serializeGraph([websiteSchema(), personSchema(), ...structuredData]);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta name="color-scheme" content="dark light" />
<meta
  name="theme-color"
  content={site.themeColor.dark}
  data-dark={site.themeColor.dark}
  data-light={site.themeColor.light}
/>

{/* Applies a saved light-theme preference before first paint. Dark is the default. */}
<script is:inline>
  (() => {
    let theme = 'dark';
    try {
      theme = localStorage.getItem('theme') ?? 'dark';
    } catch {
      /* storage unavailable: keep the default */
    }
    if (theme === 'light') {
      document.documentElement.classList.remove('dark');
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', meta.dataset.light);
    }
  })();
</script>

<link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" is:inline set:html={graph} />
