---
/** A card grid of notes: label, title, and the description. */
import CardGrid from '@/components/ui/CardGrid.astro';
import { type Note, formatDate, noteHref } from '@/lib/content';

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
---

<CardGrid
  items={notes.map((note) => ({
    href: noteHref(note),
    label: formatDate(note.data.publishedAt),
    title: note.data.title,
    description: note.data.description,
  }))}
/>
