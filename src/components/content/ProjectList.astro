---
/**
 * Project index. Each entry states the problem, the approach taken in the public
 * repository, the techniques, and what that repository demonstrates. The title links
 * to the source. Employer work lives on the résumé, not here.
 */
import Status from '@/components/ui/Status.astro';
import type { Project } from '@/lib/content';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const statusLabel = { active: 'Active', shipped: 'Shipped', archived: 'Archived' } as const;

const parts = [
  ['problem', 'Problem'],
  ['approach', 'Approach'],
  ['outcome', 'What it demonstrates'],
] as const;
---

<ol class="border-t border-line">
  {
    projects.map((project) => (
      <li class="border-b border-line py-12">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <Status tone={project.data.status === 'archived' ? 'planned' : 'live'}>
            {statusLabel[project.data.status]}
          </Status>
          <span class="mono-label text-ink-faint">{project.data.year}</span>
        </div>
        <h3 class="mt-4 font-serif text-title text-ink">
          {project.data.repository ? (
            <a
              href={project.data.repository}
              class="link-underline hover:text-accent"
              rel="noopener noreferrer"
              target="_blank"
            >
              {project.data.title}
            </a>
          ) : (
            project.data.title
          )}
        </h3>
        <p class="mt-3 max-w-2xl leading-relaxed text-ink-muted">{project.data.description}</p>
        <div class="mt-8 max-w-2xl space-y-6">
          {parts.map(([key, label]) => (
            <div>
              <h4 class="font-serif text-xl text-ink">{label}</h4>
              <p class="mt-2 leading-relaxed text-ink-muted">{project.data[key]}</p>
            </div>
          ))}
          {project.data.stack.length > 0 && (
            <div>
              <h4 class="font-serif text-xl text-ink">Techniques</h4>
              <p class="mt-2 leading-relaxed text-ink-muted">{project.data.stack.join(', ')}</p>
            </div>
          )}
        </div>
        {project.data.url && (
          <a
            href={project.data.url}
            class="link-underline mt-6 inline-block text-sm text-ink-muted hover:text-ink"
            rel="noopener noreferrer"
            target="_blank"
          >
            Live site
          </a>
        )}
      </li>
    ))
  }
</ol>
