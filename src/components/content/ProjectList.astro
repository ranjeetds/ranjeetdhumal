---
/**
 * Project cards. Each one states the problem, how the work was put together,
 * and what it demonstrates. The title links to a public repository when there is one.
 * A project that produced sample sites renders those previews across the row.
 * Template sites, when present, sit in a second section. Each snapshot is a
 * link to the page.
 */
import type { Project } from '@/lib/content';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const statusLabel = { active: 'Active', shipped: 'Shipped', archived: 'Archived' } as const;

const parts = [
  ['problem', 'Problem'],
  ['approach', 'Approach'],
  ['outcome', 'What it demonstrates'],
] as const;
---

<ul class="grid gap-px border border-line bg-line sm:grid-cols-2">
  {
    projects.map((project) => (
      <li
        id={project.id}
        class:list={[
          'scroll-mt-28 bg-canvas',
          (project.data.samples.length > 0 || project.data.templates.length > 0) && 'sm:col-span-2',
        ]}
      >
        <article class="flex h-full flex-col p-6">
          <p class="mono-label text-ink-faint">
            {statusLabel[project.data.status]}
            <span class="mx-2" aria-hidden="true">/</span>
            {project.data.year}
          </p>
          <h3 class="mt-3 font-serif text-title text-ink">
            {project.data.repository ? (
              <a
                href={project.data.repository}
                class="link-underline hover:text-accent"
                rel="noopener noreferrer"
                target="_blank"
              >
                {project.data.title}
              </a>
            ) : (
              project.data.title
            )}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">{project.data.description}</p>
          <dl class="mt-5 space-y-4">
            {parts.map(([key, label]) => (
              <div>
                <dt class="mono-label text-ink-faint">{label}</dt>
                <dd class="mt-1.5 text-sm leading-relaxed text-ink-muted">{project.data[key]}</dd>
              </div>
            ))}
          </dl>
          {project.data.stack.length > 0 && (
            <p class="mt-5 text-sm leading-relaxed text-ink-faint">{project.data.stack.join(' · ')}</p>
          )}
          {project.data.samples.length > 0 && (
            <div class="mt-6">
              <h4 class="mono-label text-ink-faint">Samples</h4>
              <ul class="mt-4 grid gap-px border border-line bg-line sm:grid-cols-2">
                {project.data.samples.map((sample) => (
                  <li class="bg-surface">
                    <a href={sample.url} class="group block" rel="noopener noreferrer" target="_blank">
                      <img
                        src={sample.image}
                        alt={`Preview of ${sample.title}${sample.place ? `, ${sample.place}` : ''}`}
                        width="960"
                        height="600"
                        loading="lazy"
                        class="aspect-[16/10] w-full bg-raised object-cover object-top"
                      />
                      <span class="block px-4 py-3">
                        <span class="text-sm text-ink group-hover:text-accent">{sample.title}</span>
                        {sample.place && <span class="mt-1 block text-sm text-ink-faint">{sample.place}</span>}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {project.data.templates.length > 0 && (
            <div class="mt-8">
              <h4 class="mono-label text-ink-faint">Templates</h4>
              <ul class="mt-4 grid gap-px border border-line bg-line sm:grid-cols-2">
                {project.data.templates.map((template) => (
                  <li class="bg-surface">
                    <a href={template.url} class="group block" rel="noopener noreferrer" target="_blank">
                      <img
                        src={template.image}
                        alt={`Preview of ${template.title}${template.place ? `, ${template.place}` : ''}`}
                        width="960"
                        height="600"
                        loading="lazy"
                        class="aspect-[16/10] w-full bg-raised object-cover object-top"
                      />
                      <span class="block px-4 py-3">
                        <span class="text-sm text-ink group-hover:text-accent">{template.title}</span>
                        {template.place && <span class="mt-1 block text-sm text-ink-faint">{template.place}</span>}
                        {template.price && <span class="mt-1 block text-sm text-ink">{template.price}</span>}
                        {template.note && <span class="mt-1 block text-sm text-ink-faint">{template.note}</span>}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {project.data.url && (
            <a
              href={project.data.url}
              class="link-underline mt-5 inline-block text-sm text-ink hover:text-accent"
              rel="noopener noreferrer"
              target="_blank"
            >
              {project.data.linkLabel}
            </a>
          )}
        </article>
      </li>
    ))
  }
</ul>
