---
/**
 * Project cards. Each one states the problem, the approach in the public repository,
 * and what that repository demonstrates. The title links to the source.
 */
import type { Project } from '@/lib/content';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const statusLabel = { active: 'Active', shipped: 'Shipped', archived: 'Archived' } as const;

const parts = [
  ['problem', 'Problem'],
  ['approach', 'Approach'],
  ['outcome', 'What it demonstrates'],
] as const;
---

<ul class="grid gap-px border border-line bg-line sm:grid-cols-2">
  {
    projects.map((project) => (
      <li id={project.id} class="scroll-mt-28 bg-canvas">
        <article class="flex h-full flex-col p-6">
          <p class="mono-label text-ink-faint">
            {statusLabel[project.data.status]}
            <span class="mx-2" aria-hidden="true">/</span>
            {project.data.year}
          </p>
          <h3 class="mt-3 font-serif text-title text-ink">
            {project.data.repository ? (
              <a
                href={project.data.repository}
                class="link-underline hover:text-accent"
                rel="noopener noreferrer"
                target="_blank"
              >
                {project.data.title}
              </a>
            ) : (
              project.data.title
            )}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">{project.data.description}</p>
          <dl class="mt-5 space-y-4">
            {parts.map(([key, label]) => (
              <div>
                <dt class="mono-label text-ink-faint">{label}</dt>
                <dd class="mt-1.5 text-sm leading-relaxed text-ink-muted">{project.data[key]}</dd>
              </div>
            ))}
          </dl>
          {project.data.stack.length > 0 && (
            <p class="mt-5 text-sm leading-relaxed text-ink-faint">{project.data.stack.join(' · ')}</p>
          )}
          {project.data.url && (
            <a
              href={project.data.url}
              class="link-underline mt-5 inline-block text-sm text-ink hover:text-accent"
              rel="noopener noreferrer"
              target="_blank"
            >
              Live site
            </a>
          )}
        </article>
      </li>
    ))
  }
</ul>
