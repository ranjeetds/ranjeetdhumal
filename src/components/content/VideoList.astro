---
/**
 * Videos as cards, grouped by series. A curated lecture with a URL links out and
 * embeds. An entry without a URL is a film this notebook has not made.
 */
import type { Video } from '@/lib/content';

interface Props {
  videos: Video[];
  /** Series in the order they should be read. Unknown series follow, alphabetically. */
  seriesOrder?: string[];
}

const { videos, seriesOrder = [] } = Astro.props;

const known = new Set(seriesOrder);
const extra = [...new Set(videos.map((video) => video.data.series))]
  .filter((series) => !known.has(series))
  .sort((a, b) => a.localeCompare(b));
const series = [...seriesOrder, ...extra].filter((name) => videos.some((video) => video.data.series === name));

const youtubeId = (url: string | undefined): string | undefined => {
  if (!url) return undefined;
  try {
    const parsed = new URL(url);
    if (parsed.hostname === 'youtu.be') {
      const id = parsed.pathname.slice(1);
      return id.length > 0 ? id : undefined;
    }
    if (parsed.hostname === 'www.youtube.com' || parsed.hostname === 'youtube.com') {
      return parsed.searchParams.get('v') ?? undefined;
    }
  } catch {
    return undefined;
  }
  return undefined;
};
---

<div class="grid gap-14">
  {
    series.map((name) => (
      <section aria-labelledby={`series-${name.replace(/\s+/g, '-').toLowerCase()}`}>
        <h3 id={`series-${name.replace(/\s+/g, '-').toLowerCase()}`} class="font-serif text-title text-ink">
          {name}
        </h3>
        <ul class="mt-6 grid gap-px border border-line bg-line sm:grid-cols-2">
          {videos
            .filter((video) => video.data.series === name)
            .map((video) => {
              const embed = youtubeId(video.data.url);
              return (
                <li id={video.id} class:list={['scroll-mt-28 bg-canvas', embed && 'sm:col-span-2']}>
                  <article class="flex h-full flex-col p-6">
                    <p class="mono-label text-ink-faint">
                      {video.data.duration ?? '—'}
                      <span class="mx-2" aria-hidden="true">/</span>
                      {video.data.origin === 'curated' ? 'Lecture' : video.data.url ? 'Published' : 'Planned'}
                    </p>
                    <h4 class="mt-3 font-serif text-title text-ink">
                      {video.data.url ? (
                        <a
                          href={video.data.url}
                          class="link-underline hover:text-accent"
                          rel="noopener noreferrer"
                          target="_blank"
                        >
                          {video.data.title}
                        </a>
                      ) : (
                        video.data.title
                      )}
                    </h4>
                    <p class="mt-3 text-sm leading-relaxed text-ink-muted">{video.data.description}</p>
                    {video.data.why && <p class="mt-3 text-sm leading-relaxed text-ink-muted">{video.data.why}</p>}
                    {video.data.companion && (
                      <p class="mt-4">
                        <a href={video.data.companion} class="link-underline text-sm text-ink hover:text-accent">
                          Open the lesson
                        </a>
                      </p>
                    )}
                    {embed && (
                      <div class="mt-5">
                        <iframe
                          class="aspect-video w-full border border-line"
                          src={`https://www.youtube-nocookie.com/embed/${embed}`}
                          title={video.data.title}
                          loading="lazy"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                          referrerpolicy="strict-origin-when-cross-origin"
                          allowfullscreen
                        />
                      </div>
                    )}
                  </article>
                </li>
              );
            })}
        </ul>
      </section>
    ))
  }
</div>
