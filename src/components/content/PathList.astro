---
/**
 * Learning paths in teaching order. Each path is an anchor, so the homepage can link
 * to a specific one. A module is a card: the outcome, why it is here, and the links
 * to an essay, a figure, or a lecture when one exists.
 */
import type { Path } from '@/lib/content';

interface Props {
  paths: Path[];
}

const { paths } = Astro.props;

const levelLabel = {
  foundational: 'Foundational',
  intermediate: 'Intermediate',
  advanced: 'Advanced',
} as const;
---

<div class="grid gap-16">
  {
    paths.map((path) => (
      <article id={path.id} class="scroll-mt-28">
        <p class="mono-label text-ink-faint">{path.data.primary ? 'The path' : levelLabel[path.data.level]}</p>
        <h3 class="mt-3 font-serif text-headline text-ink">{path.data.title}</h3>
        <ul class="mt-8 grid gap-px border border-line bg-line sm:grid-cols-2">
          {path.data.modules.map((module, index) => (
            <li class="bg-canvas">
              <div class="flex h-full flex-col p-6">
                <p class="mono-label text-ink-faint">{String(index + 1).padStart(2, '0')}</p>
                <h4 class="mt-3 font-serif text-title text-ink">{module.title}</h4>
                <p class="mt-3 text-sm leading-relaxed text-ink-muted">{module.outcome}</p>
                <p class="mt-3 text-sm leading-relaxed text-ink-muted">{module.why}</p>
                <p class="mt-3 text-sm leading-relaxed text-ink-muted">{module.next}</p>
                {module.experiment && <p class="mt-3 text-sm leading-relaxed text-ink-muted">{module.experiment}</p>}
                <p class="mt-3 text-sm leading-relaxed text-ink-faint">{module.concepts.join(' · ')}</p>
                <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-5 text-sm">
                  {module.article && (
                    <a href={module.article} class="link-underline text-ink hover:text-accent">
                      Essay
                    </a>
                  )}
                  {module.figure && (
                    <a href={`/studio/${module.figure}`} class="link-underline text-ink hover:text-accent">
                      Figure
                    </a>
                  )}
                  {module.reading && (
                    <a href={module.reading} class="link-underline text-ink hover:text-accent">
                      Lecture
                    </a>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
