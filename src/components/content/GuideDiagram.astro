---
/**
 * A static diagram for a guide that has no live studio instrument.
 * Colours come from the theme tokens. The caption says what the drawing claims.
 */
import VizFrame from '@/components/visualizations/VizFrame.astro';
import { type GuideDiagramId, guideDiagrams } from '@/data/guide-diagrams';

interface Props {
  id: GuideDiagramId;
  number?: string;
}

const { id, number = '01' } = Astro.props;
const diagram = guideDiagrams[id];
const box = 'fill-surface stroke-line-strong';
---

<VizFrame title={diagram.title} number={number}>
  <svg viewBox="0 0 640 200" role="img" aria-label={diagram.caption} class="w-full bg-surface text-ink">
    {id === 'matrix' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="70" y1="70" x2="150" y2="40" class="stroke-accent" />
        <line x1="70" y1="130" x2="150" y2="100" class="stroke-ink-faint" stroke-dasharray="4 3" />
        <rect x="210" y="60" width="120" height="80" rx="6" class={box} />
        <line x1="370" y1="100" x2="470" y2="70" class="stroke-accent" />
        <circle cx="470" cy="130" r="3" class="fill-ink-faint stroke-none" />
        <text x="248" y="105" stroke="none" class="fill-ink" font-size="14">map</text>
        <text x="40" y="64" stroke="none" class="fill-ink-muted" font-size="12">kept</text>
        <text x="40" y="148" stroke="none" class="fill-ink-muted" font-size="12">lost</text>
        <text x="490" y="74" stroke="none" class="fill-ink-muted" font-size="12">scaled</text>
        <text x="490" y="134" stroke="none" class="fill-ink-muted" font-size="12">gone</text>
      </g>
    )}
    {id === 'bias-variance' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M40 150 C 120 150, 140 40, 200 40 S 280 150, 300 150" class="stroke-ink" />
        <line x1="40" y1="110" x2="300" y2="90" class="stroke-accent" />
        <path d="M360 150 C 440 148, 470 50, 520 48 S 600 150, 620 150" class="stroke-ink" />
        <path d="M370 140 C 430 60, 500 160, 560 70 S 610 120, 620 100" class="stroke-accent" />
        <text x="40" y="28" stroke="none" class="fill-ink-muted" font-size="12">rigid, every draw</text>
        <text x="360" y="28" stroke="none" class="fill-ink-muted" font-size="12">flexible, this draw</text>
      </g>
    )}
    {id === 'test' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <defs>
          <clipPath id="guide-diagram-test-tail">
            <rect x="430" y="0" width="210" height="200" />
          </clipPath>
        </defs>
        <path
          d="M40 160 C 140 160, 180 40, 280 40 C 380 40, 460 160, 560 160 L 40 160 Z"
          clip-path="url(#guide-diagram-test-tail)"
          class="fill-accent/25 stroke-none"
        />
        <path d="M40 160 C 140 160, 180 40, 280 40 C 380 40, 460 160, 560 160" class="stroke-ink" />
        <line x1="430" y1="109" x2="430" y2="160" class="stroke-accent" />
        <text x="40" y="28" stroke="none" class="fill-ink-muted" font-size="12">results if nothing is going on</text>
        <text x="444" y="100" stroke="none" class="fill-ink-muted" font-size="12">as extreme</text>
      </g>
    )}
    {id === 'calibration' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="60" y1="170" x2="560" y2="170" class="stroke-line-strong" />
        <line x1="60" y1="170" x2="60" y2="30" class="stroke-line-strong" />
        <line x1="60" y1="170" x2="520" y2="40" class="stroke-ink-faint" />
        <path d="M60 170 C 220 168, 380 150, 520 100" class="stroke-accent" />
        <text x="300" y="125" stroke="none" class="fill-ink-muted" font-size="12">too sure</text>
        <text x="70" y="190" stroke="none" class="fill-ink-muted" font-size="12">stated probability</text>
        <text x="8" y="40" stroke="none" class="fill-ink-muted" font-size="12">frequency</text>
      </g>
    )}
    {id === 'linear' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="80" y1="30" x2="280" y2="170" class="stroke-accent" />
        <circle cx="120" cy="70" r="8" class="stroke-ink" />
        <circle cx="150" cy="50" r="8" class="stroke-ink" />
        <circle cx="180" cy="90" r="8" class="stroke-ink" />
        <rect x="200" y="120" width="14" height="14" class="stroke-ink" />
        <rect x="240" y="140" width="14" height="14" class="stroke-ink" />
        <circle cx="430" cy="60" r="8" class="stroke-ink" />
        <rect x="470" y="50" width="14" height="14" class="stroke-ink" />
        <circle cx="520" cy="120" r="8" class="stroke-ink" />
        <rect x="400" y="140" width="14" height="14" class="stroke-ink" />
        <text x="90" y="190" stroke="none" class="fill-ink-muted" font-size="12">separable</text>
        <text x="420" y="190" stroke="none" class="fill-ink-muted" font-size="12">no flat cut</text>
      </g>
    )}
    {id === 'tree' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="40" y="30" width="250" height="150" class={box} />
        <line x1="150" y1="30" x2="150" y2="180" class="stroke-accent" />
        <line x1="40" y1="100" x2="150" y2="100" class="stroke-accent" />
        <text x="70" y="70" stroke="none" class="fill-ink-muted" font-size="12">a</text>
        <text x="70" y="140" stroke="none" class="fill-ink-muted" font-size="12">b</text>
        <text x="180" y="110" stroke="none" class="fill-ink-muted" font-size="12">c</text>
        <text x="340" y="50" stroke="none" class="fill-ink" font-size="14">feature 1 &lt; t?</text>
        <text x="340" y="90" stroke="none" class="fill-ink-muted" font-size="13">yes → feature 2 &lt; s</text>
        <text x="340" y="120" stroke="none" class="fill-ink-muted" font-size="13">no → leaf c</text>
      </g>
    )}
    {id === 'split' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="40" y="70" width="160" height="60" rx="6" class={box} />
        <rect x="240" y="70" width="140" height="60" rx="6" class="fill-raised stroke-line-strong" />
        <rect x="420" y="70" width="160" height="60" rx="6" class={box} />
        <path d="M120 70 C 160 20, 460 20, 500 70" class="stroke-accent" />
        <text x="78" y="105" stroke="none" class="fill-ink" font-size="14">train</text>
        <text x="276" y="105" stroke="none" class="fill-ink-muted" font-size="14">choices</text>
        <text x="470" y="105" stroke="none" class="fill-ink" font-size="14">test</text>
        <text x="250" y="40" stroke="none" class="fill-accent" font-size="12">a feature built on both</text>
      </g>
    )}
    {id === 'retrieve' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="40" y="40" width="120" height="48" rx="6" class={box} />
        <rect x="220" y="40" width="140" height="48" rx="6" class={box} />
        <rect x="420" y="40" width="160" height="48" rx="6" class={box} />
        <line x1="160" y1="64" x2="220" y2="64" class="stroke-accent" />
        <line x1="360" y1="64" x2="420" y2="64" class="stroke-accent" />
        <rect x="220" y="120" width="160" height="48" rx="6" class="fill-raised stroke-line-strong" />
        <text x="62" y="70" stroke="none" class="fill-ink" font-size="14">query</text>
        <text x="248" y="70" stroke="none" class="fill-ink" font-size="14">passage</text>
        <text x="468" y="70" stroke="none" class="fill-ink" font-size="14">answer</text>
        <text x="236" y="150" stroke="none" class="fill-ink-muted" font-size="13">answer, no passage</text>
      </g>
    )}
    {id === 'chunk' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="40" y="50" width="360" height="100" rx="6" class={box} />
        <line x1="250" y1="50" x2="250" y2="150" class="stroke-accent" stroke-dasharray="4 3" />
        <text x="60" y="90" stroke="none" class="fill-ink" font-size="14">the rule</text>
        <text x="60" y="118" stroke="none" class="fill-ink-muted" font-size="13">applies when…</text>
        <text x="270" y="90" stroke="none" class="fill-ink-muted" font-size="14">except when…</text>
        <text x="430" y="100" stroke="none" class="fill-accent" font-size="13">kept</text>
        <text x="430" y="124" stroke="none" class="fill-ink-faint" font-size="13">dropped</text>
      </g>
    )}
    {id === 'retrieval-score' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="40" y="36" width="250" height="56" rx="6" class={box} />
        <rect x="40" y="112" width="250" height="56" rx="6" class={box} />
        <text x="56" y="70" stroke="none" class="fill-ink" font-size="14">1. Passage kept?</text>
        <text x="56" y="146" stroke="none" class="fill-ink" font-size="14">2. Answer inside it?</text>
        <text x="340" y="70" stroke="none" class="fill-ink-muted" font-size="13">missing → cut or embedding</text>
        <text x="340" y="146" stroke="none" class="fill-ink-muted" font-size="13">wandering → the reading</text>
      </g>
    )}
    {id === 'workflow' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="30" y="36" width="90" height="40" rx="6" class={box} />
        <rect x="150" y="36" width="90" height="40" rx="6" class={box} />
        <rect x="270" y="36" width="90" height="40" rx="6" class={box} />
        <line x1="120" y1="56" x2="150" y2="56" class="stroke-accent" />
        <line x1="240" y1="56" x2="270" y2="56" class="stroke-accent" />
        <rect x="420" y="110" width="160" height="50" rx="6" class={box} />
        <path d="M500 110 V 80 H 430 V 110" class="stroke-accent" />
        <text x="52" y="62" stroke="none" class="fill-ink" font-size="13">step</text>
        <text x="176" y="62" stroke="none" class="fill-ink" font-size="13">step</text>
        <text x="292" y="62" stroke="none" class="fill-ink" font-size="13">stop</text>
        <text x="30" y="100" stroke="none" class="fill-ink-muted" font-size="12">workflow, path fixed</text>
        <text x="448" y="140" stroke="none" class="fill-ink" font-size="13">model chooses</text>
        <text x="420" y="184" stroke="none" class="fill-ink-muted" font-size="12">agent, loop</text>
      </g>
    )}
    {id === 'tool' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="30" y="70" width="130" height="50" rx="6" class={box} />
        <rect x="230" y="70" width="130" height="50" rx="6" class={box} />
        <rect x="430" y="30" width="160" height="44" rx="6" class="stroke-accent fill-surface" />
        <rect x="430" y="120" width="160" height="44" rx="6" class="stroke-ink-faint fill-surface" />
        <line x1="160" y1="95" x2="230" y2="95" class="stroke-accent" />
        <line x1="360" y1="85" x2="430" y2="52" class="stroke-accent" />
        <line x1="360" y1="105" x2="430" y2="142" class="stroke-ink-faint" />
        <text x="52" y="100" stroke="none" class="fill-ink" font-size="14">proposal</text>
        <text x="262" y="100" stroke="none" class="fill-ink" font-size="14">schema</text>
        <text x="470" y="58" stroke="none" class="fill-ink" font-size="14">act</text>
        <text x="462" y="148" stroke="none" class="fill-ink-muted" font-size="14">refuse</text>
      </g>
    )}
    {id === 'weight-point' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="80" y1="100" x2="560" y2="100" class="stroke-line-strong" />
        <circle cx="140" cy="100" r="8" class="fill-ink stroke-none" />
        <circle cx="350" cy="100" r="8" class="fill-accent stroke-none" />
        <circle cx="520" cy="100" r="8" class="fill-ink stroke-none" />
        <text x="110" y="140" stroke="none" class="fill-ink-muted" font-size="12">model A</text>
        <text x="312" y="140" stroke="none" class="fill-accent" font-size="12">midpoint</text>
        <text x="490" y="140" stroke="none" class="fill-ink-muted" font-size="12">model B</text>
        <text x="80" y="48" stroke="none" class="fill-ink-muted" font-size="12">score the midpoint on data neither endpoint chose</text>
      </g>
    )}
    {id === 'task-vector' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="80" cy="110" r="7" class="fill-ink stroke-none" />
        <line x1="80" y1="110" x2="220" y2="50" class="stroke-accent" />
        <line x1="80" y1="110" x2="230" y2="150" class="stroke-ink" />
        <line x1="220" y1="50" x2="370" y2="90" class="stroke-ink" />
        <circle cx="370" cy="90" r="7" class="fill-accent stroke-none" />
        <text x="60" y="140" stroke="none" class="fill-ink-muted" font-size="12">base</text>
        <text x="150" y="36" stroke="none" class="fill-accent" font-size="12">task A</text>
        <text x="150" y="176" stroke="none" class="fill-ink-muted" font-size="12">task B</text>
        <text x="390" y="96" stroke="none" class="fill-ink" font-size="13">merged point</text>
      </g>
    )}
    {id === 'improvement' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="30" y="60" width="150" height="70" rx="6" class={box} />
        <rect x="240" y="60" width="150" height="70" rx="6" class="stroke-accent fill-surface" />
        <rect x="450" y="60" width="150" height="70" rx="6" class={box} />
        <line x1="180" y1="80" x2="240" y2="80" class="stroke-ink-faint" />
        <line x1="390" y1="110" x2="450" y2="110" class="stroke-accent" />
        <text x="58" y="100" stroke="none" class="fill-ink" font-size="14">proposer</text>
        <text x="286" y="100" stroke="none" class="fill-ink" font-size="14">fixed test</text>
        <text x="496" y="92" stroke="none" class="fill-ink" font-size="14">keep</text>
        <text x="496" y="114" stroke="none" class="fill-ink-muted" font-size="14">or reject</text>
      </g>
    )}
  </svg>
  <Fragment slot="caption">{diagram.caption}</Fragment>
</VizFrame>
