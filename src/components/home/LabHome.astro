---
/**
 * One live figure on the homepage, with cards for the others that are actually built.
 * Planned figures stay on the lab page, labelled as specified.
 */
import CardGrid from '@/components/ui/CardGrid.astro';
import Section from '@/components/ui/Section.astro';
import Viz from '@/components/visualizations/Viz.astro';
import { visualizations } from '@/components/visualizations/registry';

const live = visualizations.filter((figure) => figure.status === 'live' && figure.id !== 'sample-mean');
---

<Section id="lab" index="03" label="Lab" title="Change the picture.">
  <Viz id="sample-mean" number="02" />
  <div class="mt-8">
    <CardGrid
      items={[
        ...live.map((figure) => ({
          href: `/visual-lab#${figure.id}`,
          title: figure.title,
          description: figure.summary,
        })),
        { href: '/visual-lab', label: 'All', title: 'All figures', description: 'Built figures and the ones still specified.' },
      ]}
    />
  </div>
</Section>
