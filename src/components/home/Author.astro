---
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import { site } from '@/config/site';
---

<Section id="author" index="08" label="Author">
  <div class="max-w-3xl">
    <p class="font-serif text-headline text-ink">
      {site.name}
    </p>
    <p class="mt-3 text-ink-muted">
      {site.role} at {site.employer}, {site.location}.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <Button href="/about" variant="secondary" arrow>About this notebook</Button>
      <Button href="/resume" variant="secondary">Résumé</Button>
    </div>
  </div>
</Section>
