---
/**
 * The primary path as cards you can open before you read the full sequence.
 * Titles and order come from the path collection.
 */
import CardGrid from '@/components/ui/CardGrid.astro';
import Section from '@/components/ui/Section.astro';
import { getPublishedPaths } from '@/lib/content';

const paths = await getPublishedPaths();
const path = paths.find((candidate) => candidate.data.primary);
if (!path) throw new Error('The primary learning path is missing.');
---

<Section id="path" index="02" label="The path" title="From data to intelligence.">
  <CardGrid
    items={path.data.modules.map((module, index) => ({
      href: module.article ?? `/learning-paths#${path.id}`,
      label: String(index + 1).padStart(2, '0'),
      title: module.title,
      description: module.outcome,
    }))}
  />
</Section>
