---
import Button from '@/components/ui/Button.astro';
import Viz from '@/components/visualizations/Viz.astro';
import { site } from '@/config/site';
---

<section aria-labelledby="hero-title" class="relative isolate overflow-hidden">
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-dotgrid opacity-50 [mask-image:radial-gradient(ellipse_75%_70%_at_75%_25%,black,transparent)]"
  >
  </div>

  <div class="mx-auto grid max-w-page items-end gap-x-10 gap-y-12 px-gutter pt-16 pb-16 sm:pt-24 lg:grid-cols-12 lg:pt-28 lg:pb-20">
    <div class="lg:col-span-5">
      <p class="rise mono-label text-ink-faint" style="--i:0">
        {site.role}
        <span class="mx-2" aria-hidden="true">/</span>
        {site.location}
      </p>
      <h1 id="hero-title" class="rise mt-5 font-serif text-display text-ink" style="--i:1">
        {site.name}
      </h1>
      <p class="rise mt-4 font-serif text-title text-ink" style="--i:2">AI. Intelligence. Systems. Research.</p>
      <p class="rise mt-4 max-w-md text-ink-muted" style="--i:3">
        Senior Data Scientist exploring the foundations and frontiers of artificial intelligence — from machine learning and deep learning to generative and agentic systems.
      </p>
      <div class="rise mt-8 flex flex-wrap gap-3" style="--i:4">
        <Button href="/studio/gradient-descent" arrow>Explore Learning Studio</Button>
        <Button href="/projects" variant="secondary">Explore my work</Button>
      </div>
      <ul class="rise mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm" style="--i:5">
        <li><a href="/research" class="link-underline text-ink-muted hover:text-ink">Research</a></li>
        <li><a href="/resume" class="link-underline text-ink-muted hover:text-ink">Résumé</a></li>
        {
          site.socials.map((social) => (
            <li>
              <a href={social.href} class="link-underline text-ink-muted hover:text-ink" rel="noopener noreferrer" target="_blank">
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="rise lg:col-span-7" style="--i:4">
      <Viz id="gradient-descent" number="01" />
    </div>
  </div>
</section>
