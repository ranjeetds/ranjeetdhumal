---
import Button from '@/components/ui/Button.astro';
import Viz from '@/components/visualizations/Viz.astro';
import { site } from '@/config/site';
---

<section aria-labelledby="hero-title" class="relative isolate overflow-hidden">
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-dotgrid opacity-50 [mask-image:radial-gradient(ellipse_75%_70%_at_75%_25%,black,transparent)]"
  >
  </div>

  <div
    class="mx-auto grid max-w-page items-center gap-x-10 gap-y-14 px-gutter pt-14 pb-20 sm:pt-20 lg:grid-cols-12 lg:pt-24 lg:pb-28"
  >
    <div class="lg:col-span-5">
      <p class="rise mono-label flex items-center gap-2.5 text-ink-faint" style="--i:0">
        <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {site.tagline}
      </p>

      <h1 id="hero-title" class="rise mt-6 font-serif text-display text-ink" style="--i:1">
        Learn how intelligence works.
      </h1>

      <div class="rise mt-7 max-w-xl space-y-4 text-lede text-ink-muted" style="--i:2">
        <p>
          A public notebook of lessons, figures, and code. Start from a sample and a mean,
          then follow the mechanisms a modern system is actually made of: a loss, a search,
          a representation, attention, a distribution over the next token, and a loop that
          is allowed to act.
        </p>
      </div>

      <form action="/search" method="get" role="search" class="rise mt-8 max-w-md" style="--i:3">
        <label for="home-search" class="sr-only">Search the notebook</label>
        <div class="flex gap-2">
          <input
            id="home-search"
            name="q"
            type="search"
            placeholder="Search lessons, figures, paths"
            class="h-11 min-w-0 flex-1 border border-line-strong bg-canvas px-3 text-sm text-ink outline-none placeholder:text-ink-faint focus:border-ink"
          />
          <button type="submit" class="h-11 bg-ink px-4 text-sm font-medium text-canvas hover:bg-accent hover:text-accent-ink">
            Search
          </button>
        </div>
      </form>

      <div class="rise mt-6 flex flex-wrap gap-3" style="--i:4">
        <Button href="/explore" arrow>Explore knowledge</Button>
        <Button href="/visual-lab" variant="secondary">Enter the visual lab</Button>
      </div>
    </div>

    <div class="rise lg:col-span-7" style="--i:4">
      <Viz id="gradient-descent" number="01" />
    </div>
  </div>
</section>
