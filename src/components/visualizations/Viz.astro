---
/**
 * Renders a live visualization by id, framed and captioned from the registry.
 * This is the one place that maps ids to components and decides how each hydrates,
 * which lets Markdown/MDX authors write `<Viz id="gradient-descent" />` with no imports.
 */
import { type LiveVisualizationId, engineLabels, getVisualization } from './registry';
import Activations from './svg/Activations';
import AttentionPatterns from './svg/AttentionPatterns';
import Backpropagation from './svg/Backpropagation';
import Confusion from './svg/Confusion';
import Convolution from './svg/Convolution';
import DotProduct from './svg/DotProduct';
import Entropy from './svg/Entropy';
import GradientDescent from './svg/GradientDescent';
import Losses from './svg/Losses';
import Neighbors from './svg/Neighbors';
import Neuron from './svg/Neuron';
import NextToken from './svg/NextToken';
import Normalization from './svg/Normalization';
import PositionalEncoding from './svg/PositionalEncoding';
import SampleMean from './svg/SampleMean';
import Tokenization from './svg/Tokenization';
import VizFrame from './VizFrame.astro';

interface Props {
  id: LiveVisualizationId;
  /** Figure number within the page, e.g. "01". */
  number?: string;
  class?: string;
}

const { id, number, class: className } = Astro.props;
const visualization = getVisualization(id);
---

<VizFrame
  title={visualization.title}
  number={number}
  engine={engineLabels[visualization.engine]}
  class={className}
>
  {/* Hydrate only once scrolled into view; the server-rendered figure is already complete. */}
  {id === 'sample-mean' && <SampleMean client:visible />}
  {id === 'dot-product' && <DotProduct client:visible />}
  {id === 'loss-functions' && <Losses client:visible />}
  {id === 'gradient-descent' && <GradientDescent client:visible />}
  {id === 'neuron' && <Neuron client:visible />}
  {id === 'activations' && <Activations client:visible />}
  {id === 'backpropagation' && <Backpropagation client:visible />}
  {id === 'attention-patterns' && <AttentionPatterns client:visible />}
  {id === 'next-token' && <NextToken client:visible />}
  {id === 'tokenization' && <Tokenization client:visible />}
  {id === 'entropy' && <Entropy client:visible />}
  {id === 'normalization' && <Normalization client:visible />}
  {id === 'confusion' && <Confusion client:visible />}
  {id === 'neighbors' && <Neighbors client:visible />}
  {id === 'convolution' && <Convolution client:visible />}
  {id === 'positional-encoding' && <PositionalEncoding client:visible />}
  {visualization.caption && <Fragment slot="caption">{visualization.caption}</Fragment>}
</VizFrame>
