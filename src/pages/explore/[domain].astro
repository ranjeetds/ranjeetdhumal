---
import type { GetStaticPaths } from 'astro';
import CardGrid from '@/components/ui/CardGrid.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import { domains, type Domain } from '@/data/domains';
import { getTopic } from '@/data/topics';
import { visualizations } from '@/components/visualizations/registry';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedNotes, getPublishedProjects, getPublishedVideos, noteHref } from '@/lib/content';
import { breadcrumbSchema } from '@/lib/seo';

export const getStaticPaths = (() =>
  domains.map((domain) => ({
    params: { domain: domain.id },
    props: { domain },
  }))) satisfies GetStaticPaths;

interface Props {
  domain: Domain;
}

const { domain } = Astro.props;
const notes = (await getPublishedNotes()).filter(
  (note) => note.data.topic === domain.topicId || domain.lessons?.includes(note.id),
);
const projects = (await getPublishedProjects()).filter(
  (project) => domain.projectTag !== undefined && project.data.tags.includes(domain.projectTag),
);
const noteIds = new Set(notes.map((note) => note.id));
const referenceId = (value: unknown) => {
  if (typeof value === 'string') return value;
  if (typeof value === 'object' && value !== null) {
    const id = Reflect.get(value, 'id');
    if (typeof id === 'string') return id;
  }
  return undefined;
};
const videos = (await getPublishedVideos()).filter((video) => {
  const id = referenceId(video.data.note);
  return id !== undefined && noteIds.has(id);
});
const figures = visualizations.filter((figure) => figure.topic === domain.topicId);
const field = domain.topicId ? getTopic(domain.topicId) : undefined;
const index = String(domains.findIndex((candidate) => candidate.id === domain.id) + 1).padStart(2, '0');

const alongside = [
  ...figures.map((figure) => ({
    href: `/studio/${figure.id}`,
    label: figure.status === 'live' ? 'Figure' : 'Figure, not built',
    title: figure.title,
    description: figure.summary,
  })),
  ...videos.map((video) => ({
    href: video.data.url ?? `/videos#${video.id}`,
    label: video.data.url ? 'Video' : 'Planned film',
    title: video.data.title,
    description: video.data.description,
    external: Boolean(video.data.url),
  })),
  ...projects.map((project) => ({
    href: `/projects#${project.id}`,
    label: 'Repository',
    title: project.data.title,
    description: project.data.description,
  })),
];
---

<BaseLayout
  title={domain.title}
  description={domain.description}
  structuredData={[
    breadcrumbSchema([
      { name: 'Explore', path: '/explore' },
      { name: domain.title, path: `/explore/${domain.id}` },
    ]),
  ]}
>
  <PageHeader index={index} eyebrow="Explore" title={domain.title} />

  <Section id="map" label="Map" title="The ideas.">
    <ul class="grid gap-px border border-line bg-line sm:grid-cols-2">
      {
        domain.groups.flatMap((group) =>
          group.topics.map((topic) => (
            <li class="bg-canvas p-6">
              <p class="mono-label text-ink-faint">{group.title}</p>
              <h3 class="mt-3 font-serif text-title text-ink">{topic.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-muted">{topic.summary}</p>
            </li>
          )),
        )
      }
    </ul>
  </Section>

  <Section id="lessons" label="Lessons" title="Written so far.">
    {
      notes.length > 0 ? (
        <CardGrid
          items={notes.map((note) => ({
            href: noteHref(note),
            title: note.data.title,
            description: note.data.description,
          }))}
        />
      ) : (
        <p class="text-ink-muted">No lesson is published in this domain yet.</p>
      )
    }
    {
      field && (
        <p class="mt-8 text-sm">
          <a href={`/knowledge#${field.id}`} class="link-underline text-ink hover:text-accent">
            {field.title} on the Knowledge Hub
          </a>
        </p>
      )
    }
  </Section>

  {
    alongside.length > 0 && (
      <Section id="alongside" label="Alongside" title="Figures, films, and code.">
        <CardGrid items={alongside} />
      </Section>
    )
  }
</BaseLayout>
