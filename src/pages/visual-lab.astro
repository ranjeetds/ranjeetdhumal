---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Learning Studio" description="The visual lab is now the Learning Studio.">
  <p class="mx-auto max-w-page px-gutter py-24 text-ink-muted">
    <a href="/studio/gradient-descent" class="link-underline text-ink hover:text-accent">Continue to the Learning Studio</a>
  </p>
</BaseLayout>

<script>
  const live = new Set(['sample-mean', 'gradient-descent', 'attention-patterns', 'tokenization', 'next-token']);
  const id = location.hash.replace('#', '');
  location.replace(live.has(id) ? `/studio/${id}` : '/studio/gradient-descent');
</script>
