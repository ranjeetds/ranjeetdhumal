---
import VideoList from '@/components/content/VideoList.astro';
import Section from '@/components/ui/Section.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { getPublishedVideos } from '@/lib/content';

const videos = await getPublishedVideos();

const seriesOrder = [
  'Along the path',
  'Seeing optimization',
  'Inside a transformer',
  'Agents',
  'Reading papers',
];
---

<PageLayout section="videos">
  <Section id="library" label="Films" title="By series.">
    <VideoList videos={videos} seriesOrder={seriesOrder} />
  </Section>
</PageLayout>
