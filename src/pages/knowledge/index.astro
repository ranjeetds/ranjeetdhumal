---
/**
 * The hub is one field at a time once JavaScript runs. Without it, every field
 * stays in the page and the anchors still land.
 */
import KnowledgeHub from '@/components/knowledge/KnowledgeHub.astro';
import { getSection, sectionIndex } from '@/config/site';
import { getHub } from '@/lib/hub';
import { breadcrumbSchema } from '@/lib/seo';
import BaseLayout from '@/layouts/BaseLayout.astro';

const section = getSection('knowledge');
const model = await getHub();
---

<BaseLayout
  title={section.title}
  description={section.description}
  structuredData={[breadcrumbSchema([{ name: section.title, path: section.href }])]}
>
  <KnowledgeHub
    model={model}
    title={section.title}
    description={section.description}
    index={sectionIndex(section.id)}
  />
</BaseLayout>
