---
import ResearchList from '@/components/content/ResearchList.astro';
import Section from '@/components/ui/Section.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { getPublishedResearch } from '@/lib/content';

const entries = await getPublishedResearch();
---

<PageLayout section="research">
  <Section id="log" label="Log" title="The log">
    <ResearchList entries={entries} />
  </Section>
</PageLayout>
