---
import Button from '@/components/ui/Button.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Section from '@/components/ui/Section.astro';
import { type ResumeEntry, resume } from '@/data/resume';
import PageLayout from '@/layouts/PageLayout.astro';
import { getPublishedProjects } from '@/lib/content';

const selected = (await getPublishedProjects()).filter((project) => project.data.status !== 'archived');

const groups: { id: string; label: string; entries: ResumeEntry[] }[] = [
  { id: 'experience', label: 'Experience', entries: resume.experience },
  { id: 'education', label: 'Education', entries: resume.education },
  { id: 'publications', label: 'Publications', entries: resume.publications },
].filter((group) => group.entries.length > 0);

const isEmpty = groups.length === 0 && resume.skills.length === 0;
const ordinal = (position: number) => String(position).padStart(2, '0');
---

<PageLayout section="resume">
  {
    resume.pdf && (
      <Button slot="header" href={resume.pdf} variant="secondary" class="rise mt-9" style="--i:3" download>
        Download PDF
      </Button>
    )
  }

  {
    isEmpty && (
      <Section id="resume" label="Résumé">
        <EmptyState title="The résumé is being prepared." label="To be added">
          It will cover experience, education, publications and skills.
        </EmptyState>
      </Section>
    )
  }

  {
    groups.map((group, i) => (
      <Section id={group.id} index={ordinal(i + 1)} label="Résumé" title={group.label}>
        <ol class="border-t border-line">
          {group.entries.map((entry) => (
            <li class="grid gap-x-8 gap-y-2 border-b border-line py-7 md:grid-cols-[10rem_1fr]">
              <p class="mono-label pt-1.5 text-ink-faint">{entry.period}</p>
              <div>
                <h3 class="font-serif text-title text-ink">{entry.title}</h3>
                <p class="mt-1 text-ink-muted">
                  {entry.href ? (
                    <a href={entry.href} class="link-underline hover:text-ink">
                      {entry.organization}
                    </a>
                  ) : (
                    entry.organization
                  )}
                  {entry.location && <span class="text-ink-faint"> · {entry.location}</span>}
                </p>
                {entry.summary && (
                  <p class="mt-3 max-w-2xl leading-relaxed text-ink-muted">{entry.summary}</p>
                )}
                {entry.highlights && entry.highlights.length > 0 && (
                  <ul class="mt-3 max-w-2xl list-disc space-y-1.5 pl-5 text-ink-muted marker:text-line-strong">
                    {entry.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </Section>
    ))
  }

  {
    selected.length > 0 && (
      <Section
        id="selected-work"
        index={ordinal(groups.length + 1)}
        label="Résumé"
        title="Selected work"
      >
        <ol class="border-t border-line">
          {selected.map((project) => (
            <li class="grid gap-x-8 gap-y-2 border-b border-line py-7 md:grid-cols-[10rem_1fr]">
              <p class="mono-label pt-1.5 text-ink-faint">{project.data.year}</p>
              <div>
                <h3 class="font-serif text-title text-ink">
                  {project.data.repository ? (
                    <a
                      href={project.data.repository}
                      class="link-underline hover:text-ink"
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      {project.data.title}
                    </a>
                  ) : (
                    project.data.title
                  )}
                </h3>
                <p class="mt-3 max-w-2xl leading-relaxed text-ink-muted">{project.data.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </Section>
    )
  }

  {
    resume.skills.length > 0 && (
      <Section
        id="skills"
        index={ordinal(groups.length + (selected.length > 0 ? 1 : 0) + 1)}
        label="Résumé"
        title="Skills"
      >
        <dl class="border-t border-line">
          {resume.skills.map((group) => (
            <div class="grid gap-x-8 gap-y-1 border-b border-line py-4 md:grid-cols-[10rem_1fr]">
              <dt class="mono-label pt-1 text-ink-faint">{group.label}</dt>
              <dd class="text-ink-muted">{group.items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </Section>
    )
  }
</PageLayout>
