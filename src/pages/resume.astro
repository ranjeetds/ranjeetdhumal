---
import Button from '@/components/ui/Button.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Section from '@/components/ui/Section.astro';
import { type ResumeEntry, resume } from '@/data/resume';
import PageLayout from '@/layouts/PageLayout.astro';
import { getPublishedProjects } from '@/lib/content';

const selected = (await getPublishedProjects()).filter((project) => project.data.status !== 'archived');

const groups: { id: string; label: string; entries: ResumeEntry[] }[] = [
  { id: 'experience', label: 'Experience', entries: resume.experience },
  { id: 'education', label: 'Education', entries: resume.education },
  { id: 'publications', label: 'Publications', entries: resume.publications },
].filter((group) => group.entries.length > 0);

const isEmpty = groups.length === 0 && resume.skills.length === 0;
const ordinal = (position: number) => String(position).padStart(2, '0');
---

<PageLayout section="resume">
  {
    resume.pdf && (
      <Button slot="header" href={resume.pdf} variant="secondary" class="rise mt-9" style="--i:3" download>
        Download PDF
      </Button>
    )
  }

  {
    isEmpty && (
      <Section id="resume" label="Résumé">
        <EmptyState title="The résumé is being prepared." label="To be added">
          It will cover experience, education, publications and skills.
        </EmptyState>
      </Section>
    )
  }

  {
    groups.map((group, i) => (
      <Section id={group.id} index={ordinal(i + 1)} label="Résumé" title={group.label}>
        <ol class="grid gap-px border border-line bg-line">
          {group.entries.map((entry) => (
            <li class="bg-canvas p-6">
              <p class="mono-label text-ink-faint">{entry.period}</p>
              <h3 class="mt-3 font-serif text-title text-ink">{entry.title}</h3>
              <p class="mt-2 text-ink-muted">
                {entry.href ? (
                  <a href={entry.href} class="link-underline hover:text-accent">
                    {entry.organization}
                  </a>
                ) : (
                  entry.organization
                )}
                {entry.location && <span class="text-ink-faint"> · {entry.location}</span>}
              </p>
              {entry.summary && <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-muted">{entry.summary}</p>}
              {entry.highlights && entry.highlights.length > 0 && (
                <div class="mt-4 grid gap-px border border-line bg-line sm:grid-cols-2">
                  {entry.highlights.map((highlight) => (
                    <p class="bg-surface p-4 text-sm leading-relaxed text-ink-muted">{highlight}</p>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ol>
      </Section>
    ))
  }

  {
    selected.length > 0 && (
      <Section
        id="selected-work"
        index={ordinal(groups.length + 1)}
        label="Résumé"
        title="Selected work"
      >
        <ul class="grid gap-px border border-line bg-line sm:grid-cols-2">
          {selected.map((project) => (
            <li class="bg-canvas p-6">
              <p class="mono-label text-ink-faint">{project.data.year}</p>
              <h3 class="mt-3 font-serif text-title text-ink">
                {project.data.repository ? (
                  <a
                    href={project.data.repository}
                    class="link-underline hover:text-accent"
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {project.data.title}
                  </a>
                ) : (
                  project.data.title
                )}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-muted">{project.data.description}</p>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    resume.skills.length > 0 && (
      <Section
        id="skills"
        index={ordinal(groups.length + (selected.length > 0 ? 1 : 0) + 1)}
        label="Résumé"
        title="Skills"
      >
        <ul class="grid gap-px border border-line bg-line sm:grid-cols-2">
          {resume.skills.map((group) => (
            <li class="bg-canvas p-6">
              <p class="mono-label text-ink-faint">{group.label}</p>
              <p class="mt-3 text-sm leading-relaxed text-ink-muted">{group.items.join(' · ')}</p>
            </li>
          ))}
        </ul>
      </Section>
    )
  }
</PageLayout>
