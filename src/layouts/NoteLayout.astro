---
/**
 * Layout for a single Knowledge Hub note: header, a metadata rail and the prose column.
 * The article is marked `data-pagefind-body` so search (when added) indexes only notes' text.
 */
import BaseLayout from './BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import Status from '@/components/ui/Status.astro';
import { getSection } from '@/config/site';
import { getTopic } from '@/data/topics';
import CardGrid from '@/components/ui/CardGrid.astro';
import { type Note, formatDate, getPublishedNotes, getPublishedPaths, noteHref } from '@/lib/content';
import { articleSchema, breadcrumbSchema } from '@/lib/seo';

interface Props {
  note: Note;
}

const { note } = Astro.props;
const { title, description, publishedAt, updatedAt, maturity, tags, prerequisites, objectives, furtherReading } =
  note.data;
const topic = note.data.topic && getTopic(note.data.topic);
const hub = getSection('knowledge');
const path = noteHref(note);
const notes = await getPublishedNotes();
const primary = (await getPublishedPaths()).find((candidate) => candidate.data.primary);
const sequence = (primary?.data.notes ?? []).map((reference) => reference.id);
const place = sequence.indexOf(note.id);
const previousId = place > 0 ? sequence[place - 1] : undefined;
const nextId = place >= 0 ? sequence[place + 1] : undefined;
const previous = previousId ? notes.find((candidate) => candidate.id === previousId) : undefined;
const next = nextId ? notes.find((candidate) => candidate.id === nextId) : undefined;
const related = notes
  .filter((candidate) => candidate.id !== note.id && candidate.data.topic === note.data.topic)
  .slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  structuredData={[
    articleSchema({ title, description, path, publishedAt, updatedAt }),
    breadcrumbSchema([
      { name: hub.title, path: hub.href },
      { name: title, path },
    ]),
  ]}
>
  <article data-pagefind-body>
    <header class="mx-auto max-w-page px-gutter pt-12 pb-12 sm:pt-16 lg:pt-20 lg:pb-16">
      <a
        href={hub.href}
        class="rise mono-label inline-flex items-center gap-2 text-ink-faint transition-colors duration-200 hover:text-ink"
        style="--i:0"
      >
        <Icon name="arrow-right" class="size-3.5 rotate-180" />
        {hub.title}
      </a>
      <h1 class="rise mt-8 max-w-4xl font-serif text-display text-ink" style="--i:1">{title}</h1>
      <p class="rise mt-6 max-w-2xl text-lede text-ink-muted" style="--i:2">{description}</p>
    </header>

    <div class="border-t border-line">
      <div class="mx-auto grid max-w-page gap-x-8 gap-y-10 px-gutter py-12 lg:grid-cols-12 lg:py-16">
        <aside aria-label="About this note" class="lg:col-span-3" data-pagefind-ignore>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-5 text-sm lg:sticky lg:top-24 lg:grid-cols-1">
            <div>
              <dt class="mono-label text-ink-faint">Maturity</dt>
              <dd class="mt-1.5">
                <Status tone={maturity === 'evergreen' ? 'live' : 'planned'}>{maturity}</Status>
              </dd>
            </div>
            <div>
              <dt class="mono-label text-ink-faint">Published</dt>
              <dd class="mt-1.5 text-ink-muted">
                <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
              </dd>
            </div>
            {
              updatedAt && (
                <div>
                  <dt class="mono-label text-ink-faint">Updated</dt>
                  <dd class="mt-1.5 text-ink-muted">
                    <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time>
                  </dd>
                </div>
              )
            }
            {
              topic && (
                <div>
                  <dt class="mono-label text-ink-faint">Field</dt>
                  <dd class="mt-1.5">
                    <a href={`${hub.href}#${topic.id}`} class="link-underline text-ink-muted hover:text-ink">
                      {topic.title}
                    </a>
                  </dd>
                </div>
              )
            }
            {
              prerequisites.length > 0 && (
                <div>
                  <dt class="mono-label text-ink-faint">Prerequisites</dt>
                  <dd class="mt-1.5 text-ink-muted">{prerequisites.join(' ')}</dd>
                </div>
              )
            }
            {
              tags.length > 0 && (
                <div>
                  <dt class="mono-label text-ink-faint">Tags</dt>
                  <dd class="mt-1.5 text-ink-muted">{tags.join(', ')}</dd>
                </div>
              )
            }
          </dl>
          <nav id="note-toc" aria-label="On this page" class="mt-8 hidden lg:block" hidden></nav>
        </aside>

        <div class="min-w-0 lg:col-span-9">
          {
            objectives.length > 0 && (
              <div class="mb-10">
                <CardGrid
                  heading="p"
                  items={objectives.map((objective, index) => ({
                    label: String(index + 1).padStart(2, '0'),
                    title: objective,
                  }))}
                />
              </div>
            )
          }
          <div class="prose">
            <slot />
          </div>
          {
            furtherReading.length > 0 && (
              <div class="mt-12">
                <h2 class="font-serif text-title text-ink">Further reading</h2>
                <div class="mt-4">
                  <CardGrid
                    heading="h4"
                    items={furtherReading.map((item) => ({
                      href: item.href,
                      title: item.title,
                      external: item.href.startsWith('http'),
                    }))}
                  />
                </div>
              </div>
            )
          }
          {
            (previous || next) && (
              <nav aria-label="Lesson order" class="mt-12 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
                {previous ? (
                  <a href={noteHref(previous)} class="block">
                    <span class="mono-label text-ink-faint">Previous</span>
                    <span class="mt-2 block font-serif text-title text-ink">{previous.data.title}</span>
                  </a>
                ) : (
                  <span></span>
                )}
                {next && (
                  <a href={noteHref(next)} class="block sm:text-right">
                    <span class="mono-label text-ink-faint">Next</span>
                    <span class="mt-2 block font-serif text-title text-ink">{next.data.title}</span>
                  </a>
                )}
              </nav>
            )
          }
          {
            related.length > 0 && (
              <div class="mt-12">
                <h2 class="font-serif text-title text-ink">Related lessons</h2>
                <div class="mt-4">
                  <CardGrid
                    heading="h4"
                    items={related.map((item) => ({
                      href: noteHref(item),
                      title: item.data.title,
                      description: item.data.description,
                    }))}
                  />
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </article>
  <div id="reading-progress" class="pointer-events-none fixed inset-x-0 top-16 z-30 h-px origin-left scale-x-0 bg-accent"></div>
</BaseLayout>

<script>
  const progress = document.querySelector<HTMLElement>('#reading-progress');
  const article = document.querySelector('article .prose');
  const toc = document.querySelector<HTMLElement>('#note-toc');

  const onScroll = () => {
    if (!progress || !article) return;
    const rect = article.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const seen = Math.min(1, Math.max(0, -rect.top / (total || 1)));
    progress.style.transform = `scaleX(${seen})`;
  };
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  if (article && toc) {
    const headings = [...article.querySelectorAll<HTMLHeadingElement>('h2')];
    if (headings.length > 1) {
      const list = document.createElement('ol');
      list.className = 'mt-3 space-y-2 text-sm';
      const label = document.createElement('p');
      label.className = 'mono-label text-ink-faint';
      label.textContent = 'On this page';
      for (const heading of headings) {
        if (!heading.id) {
          heading.id = heading.textContent?.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') ?? '';
        }
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.className = 'text-ink-muted hover:text-ink';
        link.textContent = heading.textContent;
        item.append(link);
        list.append(item);
      }
      toc.append(label, list);
      toc.hidden = false;
    }
  }
</script>
