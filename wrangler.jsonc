{
  // Cloudflare Workers — static assets only (no Worker script).
  // Deploy with `npm run deploy`. Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ranjeetdhumal-com",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Serves `knowledge.html` at `/knowledge` and redirects `/knowledge/` to it,
    // matching `trailingSlash: 'never'` + `build.format: 'file'` in astro.config.mjs.
    "html_handling": "auto-trailing-slash",
    // Unknown paths return `dist/404.html` with a 404 status.
    "not_found_handling": "404-page"
  },
  // The zone is on this account. Deploy creates the DNS records and certificates.
  "routes": [
    { "pattern": "ranjeetdhumal.com", "custom_domain": true },
    { "pattern": "www.ranjeetdhumal.com", "custom_domain": true }
  ]
}
